# Cloudflare Pages Redirects for Vibe Code Leaderboard
# This file configures URL routing for shareable user profiles

# User profile routing:
# - functions/u/[username].js handles server-side OG tag injection for social media crawlers
# - This redirect serves as a fallback if the function fails or isn't deployed
/u/* /user.html 200

# Default fallback (already handled by CF Pages, but explicit here)
* /index.html 200
